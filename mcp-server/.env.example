# Base URL of the FinContext backend API.
# Local dev (default if unset): http://localhost:8000
# Prod: https://fin-context.vercel.app/_/backend
FINCONTEXT_API_BASE=http://localhost:8000

# Optional. Sent as X-API-Key. Without it, calls land in the anonymous
# rate-limit tier (30/min per IP). Only meaningful once the backend has
# FINCONTEXT_API_KEYS configured server-side — see backend/.env.example.
FINCONTEXT_API_KEY=
