# ---- Supabase (browser client — see src/app/lib/supabase.js) ----
# Publishable/anon key only. NEVER put the service-role key in a
# NEXT_PUBLIC_* var — it bypasses RLS and would ship to every browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Backend API base URL (see src/app/lib/api.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
