# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Cookies ----
# Set COOKIE_SECURE=true in production (HTTPS only)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com   # optional, for subdomain sharing

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for ephemeral preview URLs (Vercel/Netlify). Example:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Stable public frontend URL for OAuth/broker redirect targets (Google OAuth,
# Zerodha Kite callback). On Vercel prod, set this explicitly to the stable
# domain (e.g. https://fin-context.vercel.app) — do NOT rely on FRONTEND_URL
# there: this project's vercel.json uses experimentalServices ("frontend"/
# "backend"), and Vercel auto-injects an env var named after each service key
# + "_URL" (i.e. FRONTEND_URL) pointing at that service's own ephemeral
# per-deployment URL, which shadows anything set under the same name and
# isn't visible in the dashboard's env var list. Locally this isn't needed —
# falls back to FRONTEND_URL, then localhost.
PUBLIC_APP_URL=http://localhost:3000

# ---- Google OAuth ----
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---- AI providers ----
# ai_client.py precedence: OpenAI wins if set, else Groq. Set at least one or
# every AI surface (analysis/, portfolio_intelligence/, agents/) is disabled.
# Note: there is currently NO runtime fallback between providers — see
# AGENTS.md "Known gaps". Anthropic/Gemini are not wired into ai_client.py
# despite being installed as deps; don't assume ANTHROPIC_API_KEY does anything
# yet.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- CrewAI (backend/app/agents/) ----
# Narrative-to-Numbers + Risk Brief crews. Groq only right now (base.py hard-
# requires GROQ_API_KEY independent of the ai_client provider choice above).
# crewai + crewai-tools are pinned in requirements.txt — don't rely on them
# being pulled in transitively, they weren't for a while (see AGENTS.md).
CREWAI_MODEL=groq/llama-3.3-70b-versatile
CREWAI_TEMPERATURE=0.2
# Smaller/quicker model for narrow-extraction agents (currently just the
# Narrative Extractor — see registry.make_narrative_extractor). Leave unset
# to use CREWAI_MODEL everywhere; only helps TTFR if you opt an agent in via
# `_agent(fast=True, ...)`.
CREWAI_FAST_MODEL=groq/llama-3.1-8b-instant
# Per-task ceiling so one slow/looping call can't blow up request latency.
# Applied to every Agent via registry._agent().
CREWAI_TIMEOUT_SECONDS=20
CREWAI_MAX_ITER=6

# ---- Embeddings (semantic news retrieval) ----
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Supabase (vector store, outcome ledger, telegram, social/peer-pulse) ----
# Service-role key — NOT the anon/publishable key. Dashboard → Project
# Settings → API. Bypasses RLS; only ever used server-side.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- MCP / programmatic access ----
# Comma-separated shared API keys for POST /api/analysis/pre-trade-check and
# /api/analysis/context (see core/rate_limit.py). Optional — those routes
# work without a key (the web frontend calls them with none), just at a
# lower rate-limit tier (30/min per IP vs 120/min per key). Only matters once
# you're issuing keys to the MCP server / other programmatic callers.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
FINCONTEXT_API_KEYS=

# ---- Admin-gated endpoints ----
# Gates POST /api/outcomes/compute-daily, /api/portfolio-intelligence/prewarm-demo,
# /api/portfolio-intelligence/cache-stats, /api/embeddings/* admin routes.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---- Telegram bot (optional) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# WEB_APP_URL=https://fincontext.app

# ---- Brokerage (Zerodha Kite Connect) ----
KITE_API_KEY=
KITE_API_SECRET=

# ---- Error monitoring (Sentry) ----
# Project: fincontext-backend, org: compute-ji. Leave unset locally — Sentry
# is a no-op (see main.py) unless SENTRY_DSN is set. Set only in prod/staging
# deploy env. send_default_pii is hardcoded off (portfolio/financial data).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- LLM observability (Langfuse) ----
# Traces every ai_client.py call + CrewAI crew kickoff — see
# app/services/llm_trace.py. Leave LANGFUSE_PUBLIC_KEY unset to disable
# (no-op, same pattern as Sentry above). Get keys from the Langfuse project
# dashboard. Only structured metadata is sent, never raw prompt/completion
# text — see the privacy note at the top of llm_trace.py before changing that.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
